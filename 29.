#include <stdio.h>

int main(void) {
    int numbers[5];
    int sum = 0;
    
    printf("Enter 5 numbers sequentially:\n");
    for (int i = 0; i < 5; i++) {
        printf("Number %d: ", i + 1);
        scanf("%d", &numbers[i]);
        sum += numbers[i]; // Track the absolute sum for the average
    }

    // Assume the first number is both the lowest and highest initially
    int max = numbers[0];
    int min = numbers[0];

    for (int i = 1; i < 5; i++) {
        if (numbers[i] > max) {
            max = numbers[i];
        }
        if (numbers[i] < min) {
            min = numbers[i];
        }
    }

    float average = (float)sum / 5;

    printf("\n=== Array Summary ===\n");
    printf("Highest Value: %d\n", max);
    printf("Lowest Value:  %d\n", min);
    printf("Average Value: %.2f\n", average);

    return 0;
}
