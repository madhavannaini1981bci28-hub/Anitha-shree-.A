#include <stdio.h>

int main(void) {
    char text[100];
    int length = 0;

    printf("Enter a word (no spaces): ");
    scanf("%99s", text); // %99s protects against buffer overflows

    // Calculate length manually without string.h library
    while (text[length] != '\0') {
        length++;
    }

    printf("Reversed output: ");
    // Loop backwards from index (length - 1) down to index 0
    for (int i = length - 1; i >= 0; i--) {
        putchar(text[i]);
    }
    printf("\n");

    return 0;
}
