#include <stdio.h>

int main(void) {
    int number, is_prime = 1; // 1 means True, 0 means False

    printf("Enter a positive integer: ");
    scanf("%d", &number);

    // Numbers less than or equal to 1 are not prime
    if (number <= 1) {
        is_prime = 0;
    } else {
        // Check for any clean divisors from 2 up to half of the target number
        for (int i = 2; i <= number / 2; i++) {
            if (number % i == 0) {
                is_prime = 0; // Found a factor, so it's not a prime number
                break;        // Exit the loop early to save processing time
            }
        }
    }

    if (is_prime == 1) {
        printf("%d is a prime number!\n", number);
    } else {
        printf("%d is not a prime number.\n", number);
    }

    return 0;
}
