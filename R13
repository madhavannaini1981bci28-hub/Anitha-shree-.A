#include <stdbool.h>
#include <stdlib.h>

typedef struct {
    int* data;
    int front;
    int rear;
    int size;
    int capacity;
} MyCircularDeque;

// Initializes the deque with a maximum size of k.
MyCircularDeque* myCircularDequeCreate(int k) {
    MyCircularDeque* obj = (MyCircularDeque*)malloc(sizeof(MyCircularDeque));
    obj->data = (int*)malloc(k * sizeof(int));
    obj->front = 0;
    obj->rear = 0;
    obj->size = 0;
    obj->capacity = k;
    return obj;
}

// Returns true if the deque is empty, or false otherwise.
bool myCircularDequeIsEmpty(MyCircularDeque* obj) {
    return obj->size == 0;
}

// Returns true if the deque is full, or false otherwise.
bool myCircularDequeIsFull(MyCircularDeque* obj) {
    return obj->size == obj->capacity;
}

// Adds an item at the front of Deque.
bool myCircularDequeInsertFront(MyCircularDeque* obj, int value) {
    if (myCircularDequeIsFull(obj)) {
        return false;
    }
    // Circularly decrement front pointer: (front - 1 + capacity) % capacity
    obj->front = (obj->front - 1 + obj->capacity) % obj->capacity;
    obj->data[obj->front] = value;
    obj->size++;
    return true;
}

// Adds an item at the rear of Deque.
bool myCircularDequeInsertLast(MyCircularDeque* obj, int value) {
    if (myCircularDequeIsFull(obj)) {
        return false;
    }
    // Insert value at rear, then circularly increment rear pointer
    obj->data[obj->rear] = value;
    obj->rear = (obj->rear + 1) % obj->capacity;
    obj->size++;
    return true;
}

// Deletes an item from the front of Deque.
bool myCircularDequeDeleteFront(MyCircularDeque* obj) {
    if (myCircularDequeIsEmpty(obj)) {
        return false;
    }
    // Circularly increment front pointer
    obj->front = (obj->front + 1) % obj->capacity;
    obj->size--;
    return true;
}

// Deletes an item from the rear of Deque.
bool myCircularDequeDeleteLast(MyCircularDeque* obj) {
    if (myCircularDequeIsEmpty(obj)) {
        return false;
    }
    // Circularly decrement rear pointer
    obj->rear = (obj->rear - 1 + obj->capacity) % obj->capacity;
    obj->size--;
    return true;
}

// Returns the front item from the Deque. Returns -1 if empty.
int myCircularDequeGetFront(MyCircularDeque* obj) {
    if (myCircularDequeIsEmpty(obj)) {
        return -1;
    }
    return obj->data[obj->front];
}

// Returns the last item from Deque. Returns -1 if empty.
int myCircularDequeGetRear(MyCircularDeque* obj) {
    if (myCircularDequeIsEmpty(obj)) {
        return -1;
    }
    // The actual last element is at (rear - 1 + capacity) % capacity
    int actualRearIndex = (obj->rear - 1 + obj->capacity) % obj->capacity;
    return obj->data[actualRearIndex];
}

// Frees the allocated memory.
void myCircularDequeFree(MyCircularDeque* obj) {
    free(obj->data);
    free(obj);
}
