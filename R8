int removeDuplicates(int* nums, int numsSize) {
    if (numsSize == 0) {
        return 0;
    }
    
    // k tracks the index of the last unique element
    int k = 0; 
    
    for (int i = 1; i < numsSize; i++) {
        // If we find a new unique element
        if (nums[i] != nums[k]) {
            k++;
            nums[k] = nums[i];
        }
    }
    
    // The number of unique elements is the index + 1
    return k + 1;
}

