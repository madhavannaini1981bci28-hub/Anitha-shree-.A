int maxSubarraySumCircular(int* nums, int numsSize) {
    int total_sum = 0;
    int curr_max = nums[0], max_sum = nums[0];
    int curr_min = nums[0], min_sum = nums[0];

    for (int i = 0; i < numsSize; i++) {
        total_sum += nums[i];
        
        if (i > 0) {
            curr_max = (curr_max + nums[i] > nums[i]) ? (curr_max + nums[i]) : nums[i];
            max_sum = (curr_max > max_sum) ? curr_max : max_sum;

            curr_min = (curr_min + nums[i] < nums[i]) ? (curr_min + nums[i]) : nums[i];
            min_sum = (curr_min < min_sum) ? curr_min : min_sum;
        }
    }

    return (max_sum > 0) ? ((total_sum - min_sum > max_sum) ? (total_sum - min_sum) : max_sum) : max_sum;
}
