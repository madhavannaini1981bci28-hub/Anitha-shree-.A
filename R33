#include <stdio.h>
#include <stdlib.h>

// Comparison function for qsort
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

void backtrack(int* nums, int numsSize, int* current, int* used, int** results, int* returnSize, int currentIdx) {
    if (currentIdx == numsSize) {
        results[*returnSize] = (int*)malloc(numsSize * sizeof(int));
        for (int i = 0; i < numsSize; i++) {
            results[*returnSize][i] = current[i];
        }
        (*returnSize)++;
        return;
    }

    for (int i = 0; i < numsSize; i++) {
        // Skip if this element is already used in the current permutation
        if (used[i]) continue;

        // Skip duplicates: only use the first available identical element to avoid redundant branches
        if (i > 0 && nums[i] == nums[i - 1] && !used[i - 1]) continue;

        // Choose
        used[i] = 1;
        current[currentIdx] = nums[i];

        // Explore
        backtrack(nums, numsSize, current, used, results, returnSize, currentIdx + 1);

        // Unchoose (Backtrack)
        used[i] = 0;
    }
}

int** permuteUnique(int* nums, int numsSize, int* returnSize, int** returnColumnSizes) {
    // Sort the input to group duplicates together
    qsort(nums, numsSize, sizeof(int), compare);

    // Max possible permutations for 8 elements is 8! = 40,320
    int maxPermutations = 40320; 
    int** results = (int**)malloc(maxPermutations * sizeof(int*));
    *returnSize = 0;

    int* current = (int*)malloc(numsSize * sizeof(int));
    int* used = (int*)calloc(numsSize, sizeof(int));

    backtrack(nums, numsSize, current, used, results, returnSize, 0);

    // Allocate memory for column sizes tracking (each row has exactly numsSize elements)
    *returnColumnSizes = (int*)malloc((*returnSize) * sizeof(int));
    for (int i = 0; i < *returnSize; i++) {
        (*returnColumnSizes)[i] = numsSize;
    }

    free(current);
    free(used);
    return results;
}
