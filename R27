#include <stdlib.h>

typedef struct {
    int* data;     // Stores the actual elements
    int* minData;  // Stores the minimum value up to that level
    int top;       // Pointer to the top element index
} MinStack;

/** Initializes the stack object. */
MinStack* minStackCreate() {
    MinStack* obj = (MinStack*)malloc(sizeof(MinStack));
    // Based on constraints, at most 30,000 calls will be made
    obj->data = (int*)malloc(30000 * sizeof(int));
    obj->minData = (int*)malloc(30000 * sizeof(int));
    obj->top = -1;
    return obj;
}

/** Pushes the element value onto the stack. */
void minStackPush(MinStack* obj, int val) {
    obj->top++;
    obj->data[obj->top] = val;
    
    // If it's the first element, it is the minimum.
    // Otherwise, compare it with the previous minimum.
    if (obj->top == 0) {
        obj->minData[obj->top] = val;
    } else {
        int currentMin = obj->minData[obj->top - 1];
        obj->minData[obj->top] = (val < currentMin) ? val : currentMin;
    }
}

/** Removes the element on the top of the stack. */
void minStackPop(MinStack* obj) {
    if (obj->top >= 0) {
        obj->top--;
    }
}

/** Gets the top element of the stack. */
int minStackTop(MinStack* obj) {
    return obj->data[obj->top];
}

/** Retrieves the minimum element in the stack. */
int minStackGetMin(MinStack* obj) {
    return obj->minData[obj->top];
}

/** Frees the memory allocated for the stack. */
void minStackFree(MinStack* obj) {
    free(obj->data);
    free(obj->minData);
    free(obj);
}

