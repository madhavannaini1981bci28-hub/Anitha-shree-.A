int removeDuplicates(int* nums, int numsSize) {
    // If the array has 2 or fewer elements, every element can appear at most twice safely.
    if (numsSize <= 2) {
        return numsSize;
    }

    // 'index' points to the position where the next valid element should be placed.
    int index = 2;

    // Start scanning from the 3rd element (index 2) to the end of the array.
    for (int i = 2; i < numsSize; i++) {
        // Compare the current element with the element placed two positions back.
        // If it's different, it means this element has appeared at most twice so far.
        if (nums[i] != nums[index - 2]) {
            nums[index] = nums[i];
            index++;
        }
    }

    // 'index' represents the total count of valid elements ('k').
    return index;
}
